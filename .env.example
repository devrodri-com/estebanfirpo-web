# Server-only | Required for contact email delivery; not required to build.
RESEND_API_KEY=

# Public | Optional. Metadata falls back to the public canonical site URL.
NEXT_PUBLIC_SITE_URL=

# Public | Optional for the site; required only for useful analytics tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public | Optional for current assets; required when the ImageKit loader receives a relative path.
NEXT_PUBLIC_IMAGEKIT_BASE_URL=
